+def _safe_compare(op, lhs, rhs):
+    """Safely compare lhs and rhs using op ('<', '<=', '>', '>=') returning False on TypeError.
+    """
+    try:
+        if op == '<':
+            return lhs < rhs
+        if op == '<=':
+            return lhs <= rhs
+        if op == '>':
+            return lhs > rhs
+        if op == '>=':
+            return lhs >= rhs
+    except TypeError:
+        return False
+
